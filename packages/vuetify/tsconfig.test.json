{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "jsdom"],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "**/*.spec.ts",
    "**/*.spec.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}



